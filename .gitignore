# OS and editor cruft
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# The projects here are dependency-free; this is a guard in case one ever
# gains a package manager.
node_modules/

# Local scratch
*.local

# Wiekentwie/WieKentWie.xlsm is a real workbook holding real contact data and
# document metadata. It stays local: the VBA source (WieKentWie.bas) is what is
# worth publishing, and the workbook can be rebuilt by importing it.
*.xlsm

# `dither-studio/` is Dither Studio published as its own app repository
# (https://github.com/thijnperd/dither-studio): the same app plus app-mode
# launchers, an installable manifest, generated icons, a guide and CI. It is a
# copy with its own git history, so it stays out of this repository — see
# `dither studio web/README.md` for the pairing rule.
dither-studio/
